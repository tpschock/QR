GEMINI_API_KEY=AIza...

# Optional — password-protects the "/" directory page only. Leave both
# blank/unset to leave the directory open. Individual property pages
# ("/<slug>") are never affected by these.
DIRECTORY_USER=
DIRECTORY_PASSWORD=

# Optional — lets visitors leave contact info in the chat for a call back.
# Leave any of these unset to skip that delivery method; the "Request a
# call back" form still works and shows a success message either way, it
# just won't actually notify anyone until at least one method is set up.
# See "Capturing leads" in the README for setup steps.

# Email notification (any standard SMTP provider, e.g. Gmail with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
LEAD_NOTIFICATION_EMAIL=

# Google Sheet logging (via a linked Google Form, no API key needed)
GOOGLE_FORM_ACTION_URL=
GOOGLE_FORM_ENTRY_NAME=
GOOGLE_FORM_ENTRY_PHONE=
GOOGLE_FORM_ENTRY_EMAIL=
GOOGLE_FORM_ENTRY_PROPERTY=
